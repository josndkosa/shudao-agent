# 统一编辑器行为：缩进/换行/编码（跨 Windows/macOS/Linux 一致）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4

[*.{js,mjs,html,css,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false