# 蜀道智行环境配置模板——复制为 .env 并填入真实值（.env 已被 gitignore，绝不入库）
# SD_LLM_MODE: auto（默认）/ online / offline（答辩断网保命开关）
# DEEPSEEK_API_KEY: DeepSeek 开放平台 API key
# SD_ALLOW_ONLINE: 公网防护开关——auto 模式下显式设 1 才走在线（ECS 部署务必想清楚再开；
#   本地答辩演示建议直接 SD_LLM_MODE=online 或在 .env 里设 SD_ALLOW_ONLINE=1）
# SD_LLM_MODE=offline
# DEEPSEEK_API_KEY=
# SD_ALLOW_ONLINE=1
