# LLM 模式: auto(有key走在线,无key离线兜底) / offline(强制离线) / online(强制在线)
SD_LLM_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 华为云 OBS（可选：四个齐全才启用，未配置自动跳过）
OBS_ENDPOINT=
OBS_BUCKET=
OBS_AK=
OBS_SK=
OBS_REGION=cn-north-4

# 华为云 FunctionGraph 天气函数（可选：存在即启用，2s 超时回落本地快照）
FG_WEATHER_URL=
